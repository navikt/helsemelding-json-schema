{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "no.nav.helsemelding.jsonschema.core.model.IncomingDialogMessage",
    "description": "An incoming dialog message",
    "type": "object",
    "properties": {
        "version": {
            "type": "integer",
            "description": "The current schema version"
        },
        "id": {
            "type": "string",
            "description": "Unique identifier of the dialog message"
        },
        "type": {
            "$ref": "#/$defs/no.nav.helsemelding.jsonschema.core.model.IncomingDialogMessageType",
            "description": "Type of dialog message"
        },
        "receivedAt": {
            "type": "string",
            "description": "Date and time the dialog message was received (UTC)"
        },
        "patientIdent": {
            "type": "string",
            "description": "National identity number (11 digits) of the patient"
        },
        "conversationReference": {
            "oneOf": [
                {
                    "type": "null"
                },
                {
                    "$ref": "#/$defs/no.nav.helsemelding.jsonschema.core.model.ConversationReference"
                }
            ],
            "description": "Conversation this message belongs to"
        },
        "message": {
            "type": [
                "string",
                "null"
            ],
            "description": "Message text"
        },
        "numberOfAttachments": {
            "type": "integer",
            "description": "Number of attachments"
        },
        "provider": {
            "$ref": "#/$defs/no.nav.helsemelding.jsonschema.core.model.Provider",
            "description": "Information about the doctor specified in the message"
        },
        "signature": {
            "$ref": "#/$defs/no.nav.helsemelding.jsonschema.core.model.Signature",
            "description": "Information about the signature"
        },
        "documentId": {
            "type": "string",
            "description": "Document ID of the message in the document archive"
        }
    },
    "additionalProperties": false,
    "required": [
        "version",
        "id",
        "type",
        "receivedAt",
        "patientIdent",
        "conversationReference",
        "message",
        "numberOfAttachments",
        "provider",
        "signature",
        "documentId"
    ],
    "$defs": {
        "no.nav.helsemelding.jsonschema.core.model.IncomingDialogMessageType": {
            "type": "string",
            "enum": [
                "ACCEPTS_MEETING_INVITATION",
                "REQUESTS_NEW_MEETING_TIME",
                "DECLINES_MEETING_WITH_REASON",
                "PATIENT_REQUEST_RESPONSE",
                "SICK_LEAVE_FOLLOW_UP_INQUIRY",
                "PATIENT_INQUIRY"
            ]
        },
        "no.nav.helsemelding.jsonschema.core.model.ConversationReference": {
            "type": "object",
            "description": "Information about the conversation",
            "properties": {
                "parentMessageId": {
                    "type": "string",
                    "description": "Reference to previous dialog message in conversation"
                },
                "conversationId": {
                    "type": "string",
                    "description": "Reference to conversation (typically the same id as initial dialog message)"
                }
            },
            "required": [
                "parentMessageId",
                "conversationId"
            ],
            "additionalProperties": false
        },
        "no.nav.helsemelding.jsonschema.core.model.Provider": {
            "type": "object",
            "description": "Information about the doctor specified in the message",
            "properties": {
                "ident": {
                    "type": "string",
                    "description": "National identity number (11 digits) of the doctor specified in the message"
                },
                "hprNumber": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "HPR-number of the doctor specified in the message in the Helsepersonellregisteret"
                },
                "office": {
                    "$ref": "#/$defs/no.nav.helsemelding.jsonschema.core.model.ProviderOffice",
                    "description": "Information about the provider office specified in the message"
                }
            },
            "required": [
                "ident",
                "hprNumber",
                "office"
            ],
            "additionalProperties": false
        },
        "no.nav.helsemelding.jsonschema.core.model.ProviderOffice": {
            "type": "object",
            "description": "Information about the doctor's office specified in the message",
            "properties": {
                "orgNumber": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "Organisation number of the doctor's office in the Enhetsregisteret"
                },
                "orgName": {
                    "type": "string",
                    "description": "Name of the doctor's office"
                },
                "herId": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "description": "HER-id of the doctor's office in the Adresseregisteret"
                }
            },
            "required": [
                "orgNumber",
                "orgName",
                "herId"
            ],
            "additionalProperties": false
        },
        "no.nav.helsemelding.jsonschema.core.model.Signature": {
            "type": "object",
            "description": "Information about the signature",
            "properties": {
                "signingProviderIdent": {
                    "type": "string",
                    "description": "National identity number (11 digits) of the doctor who signed the message"
                },
                "signedAt": {
                    "type": "string",
                    "description": "Date and time the message was signed"
                }
            },
            "required": [
                "signingProviderIdent",
                "signedAt"
            ],
            "additionalProperties": false
        }
    }
}