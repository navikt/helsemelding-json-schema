{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "no.nav.helsemelding.jsonschema.core.model.ErrorMessage",
    "description": "An error when message couldn't be delivered",
    "type": "object",
    "properties": {
        "version": {
            "type": "integer",
            "description": "The current schema version"
        },
        "processedAt": {
            "description": "Date and time the dialog message was processed (UTC)",
            "type": "string",
            "format": "date-time"
        },
        "sourceSystem": {
            "type": "string",
            "description": "Value of the sourceSystem header from the rejected record"
        },
        "messageId": {
            "oneOf": [
                {
                    "type": "null"
                },
                {
                    "$ref": "#/$defs/kotlin.uuid.Uuid"
                }
            ],
            "description": "Unique identifier of the dialog message"
        },
        "errors": {
            "type": "array",
            "description": "List of possible errors when processing the message",
            "items": {
                "$ref": "#/$defs/no.nav.helsemelding.jsonschema.core.model.ProcessingError"
            }
        },
        "originalMessage": {
            "oneOf": [
                {
                    "type": "null"
                },
                {
                    "$ref": "#/$defs/no.nav.helsemelding.jsonschema.core.model.OriginalMessage"
                }
            ],
            "description": "Information about the original message"
        }
    },
    "additionalProperties": false,
    "required": [
        "version",
        "processedAt",
        "sourceSystem",
        "messageId",
        "errors",
        "originalMessage"
    ],
    "$defs": {
        "kotlin.uuid.Uuid": {
            "type": "string",
            "format": "uuid",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "no.nav.helsemelding.jsonschema.core.model.ProcessingError": {
            "type": "object",
            "description": "Error when processing a message",
            "properties": {
                "category": {
                    "$ref": "#/$defs/no.nav.helsemelding.jsonschema.core.model.ErrorCategory",
                    "description": "Error category"
                },
                "code": {
                    "$ref": "#/$defs/no.nav.helsemelding.jsonschema.core.model.ErrorCode",
                    "description": "Machine-readable error code"
                },
                "message": {
                    "type": "string",
                    "description": "Human-readable error description"
                }
            },
            "required": [
                "category",
                "code",
                "message"
            ],
            "additionalProperties": false
        },
        "no.nav.helsemelding.jsonschema.core.model.ErrorCategory": {
            "type": "string",
            "enum": [
                "VALIDATION",
                "CONVERSION",
                "SIGNING"
            ]
        },
        "no.nav.helsemelding.jsonschema.core.model.ErrorCode": {
            "type": "string",
            "enum": [
                "INVALID_KAFKA_VALUE",
                "MISSING_SOURCE_SYSTEM_HEADER",
                "INVALID_MESSAGE",
                "CONVERSION_ERROR",
                "MESSAGE_ID_EXTRACTION_ERROR",
                "PDL_ERROR",
                "PROVIDER_REGISTRY_ERROR",
                "SIGNING_ERROR"
            ]
        },
        "no.nav.helsemelding.jsonschema.core.model.OriginalMessage": {
            "type": "object",
            "description": "Information about the original message",
            "properties": {
                "publishedAt": {
                    "description": "Date and time the dialog message was published (UTC)",
                    "type": "string",
                    "format": "date-time"
                },
                "payload": {
                    "type": "string",
                    "description": "Original record (JSON) published to helsemelding.dialog.out"
                }
            },
            "required": [
                "publishedAt",
                "payload"
            ],
            "additionalProperties": false
        }
    }
}